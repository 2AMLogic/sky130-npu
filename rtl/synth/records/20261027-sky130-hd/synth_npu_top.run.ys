# Machine-local rehydration of 'synth_npu_top.ys' (issue #1870): the PDK-root
# placeholder has been substituted with this machine's resolved PDK
# install root, so this file is runnable but NOT commit-safe. Commit
# 'synth_npu_top.ys' instead.
read_verilog rtl/npu_top.v
